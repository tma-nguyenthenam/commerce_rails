<%= hidden_field_tag 'categories_path', categories_path %>

<%= form_with(model: @product, local: true, multipart: true, class: "form",  data: { component: "product-form" }) do |f| %>
  <% if @product.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@product.errors.count, "error") %> prohibited this product:</h2>
      <ul>
        <% @product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description, rows: 3 %>
  </div>

  <div class="field">
    <%= f.label :price %>
    <%= f.number_field :price, step: "0.01", min: 0, required: true %>
  </div>

  <div class="field">
    <%= f.label :stock %>
    <%= f.number_field :stock, min: 0, required: true %>
  </div>

  <div class="field category-field">
    <%= f.label :category_id, "Category" %>
    <div class="category-row">
    <%= f.collection_select :category_id, @categories || [], :id, :name,
    { prompt: "Select a category" },
    { id: "product_category_id", required: true } %>
      <button type="button" id="open-category-dialog" class="btn btn-secondary">
        + New Category
      </button>
    </div>
  </div>

  <div class="field">
    <%= f.label :tagline %>
    <%= f.text_field :tagline, placeholder: "Short catchy line shown on listings" %>
  </div>

  <div class="field checkbox-field">
    <%= f.check_box :is_new %>
    <%= f.label :is_new, "Mark as New" %>
  </div>

  <div class="field">
    <%= f.label :slug %>
    <%= f.text_field :slug, placeholder: "auto-generated from name if left blank" %>
    <small class="hint">Used in image storage path: products/&lt;id&gt;/&lt;slug&gt;. Leave blank to auto-generate.</small>
  </div>

  <div class="field">
    <%= f.label :colors, "Colors" %>
    <div id="color-picker-container" data-colors="<%= (@product.colors || []).to_json %>">
      <div id="color-list" class="color-list">
        <% (@product.colors || []).each_with_index do |color, i| %>
          <div class="color-item" style="--swatch: <%= color %>;">
            <input type="color" value="<%= color %>" class="color-input" data-index="<%= i %>">
            <input type="text" class="color-text" value="<%= color %>" data-index="<%= i %>">
            <button type="button" class="btn btn-danger remove-color">×</button>
          </div>
        <% end %>
      </div>
      <button type="button" id="add-color" class="btn btn-secondary">+ Add Color</button>
      <!-- Hidden inputs submitted with the form -->
      <div id="colors-hidden">
        <% (@product.colors || []).each do |color| %>
          <input type="hidden" name="product[colors][]" value="<%= color %>">
        <% end %>
      </div>
    </div>
    <small class="hint">Pick a color and it is stored as a hex string in a Postgres array.</small>
  </div>

  <div class="field">
    <%= f.label :options, "Options (JSON)" %>
    <%= f.text_area :options,
        value: (@product.options.present? ? JSON.pretty_generate(@product.options) : "{}"),
        rows: 8,
        class: "code-textarea",
        placeholder: '' %>
    <small class="hint">Enter valid JSON. Stored as jsonb.</small>
    <div id="options-error" class="error-msg" style="display:none;">Invalid JSON</div>
  </div>

  <div class="field">
    <%= f.label :thumbnail, "Thumbnail Image" %>
    <% if @product.thumbnail.present? %>
      <div class="current-thumbnail">
        <img src="<%= product_image_url(@product.thumbnail) %>" alt="Current thumbnail" style="max-width:160px;">
      </div>
    <% end %>
    <%= file_field_tag "product[thumbnail_upload]",
        accept: "image/*",
        class: "file-input",
        id: "product_thumbnail_upload" %>
    <small class="hint">Saved to storage/products/&lt;id&gt;/&lt;slug&gt;_thumbnail.&lt;ext&gt;</small>
  </div>

  <div class="field">
    <%= f.label :images, "Gallery Images" %>
    <% if (@product.images || []).any? %>
      <div class="current-images">
        <% @product.images.each do |img| %>
          <img src="<%= product_image_url(img) %>" alt="Gallery image" style="max-width:120px;margin-right:8px;">
        <% end %>
      </div>
    <% end %>
    <%= file_field_tag "product[image_uploads][]",
        multiple: true,
        accept: "image/*",
        class: "file-input",
        id: "product_image_uploads" %>
    <small class="hint">Saved as storage/products/&lt;id&gt;/&lt;slug&gt;_index_slide_&lt;index&gt;.&lt;ext&gt;</small>
  </div>

  <div class="actions">
    <%= f.submit "Save Product", class: "btn btn-primary" %>
  </div>
<% end %>

<dialog id="category-dialog" data-component="category-dialog" data-form-url="<%= categories_path %>">
  <form id="category-form">
    <h3>New Category</h3>

    <div class="field">
      <label for="category_name">Name</label>
      <input type="text" id="category_name" name="category[name]" required>
    </div>

    <div class="field">
      <label for="category_description">Description</label>
      <textarea id="category_description" name="category[description]" rows="3"></textarea>
    </div>

    <div id="category-errors" class="errors" style="display:none;"></div>

    <div class="dialog-actions">
      <button type="submit" class="btn btn-primary">Save Category</button>
      <button type="button" id="cancel-category-dialog" class="btn">Cancel</button>
    </div>
  </form>
</dialog>
